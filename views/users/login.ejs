<% layout("layouts/boilerplate") -%>

<div class="row mb-3" style="background-image: url('/Images/santorini_hd.png'); background-size:cover; background-position:center; position: relative; display: flex; flex-direction: column; justify-content: start; align-items: center; width: 100%; min-height: 400px;">
    <h1 class="mt-3" style="color: rgb(255, 255, 255); display: flex; justify-content: center; align-items: center;">WELCOME BACK</h1>
    <P class="" style="color: rgb(250, 244, 244); display: flex; justify-content: center; align-items: center;">Welcome back! please enter your details.</P>
  <div class="">
    <form action="/login" method="post" class="needs-validation mt-4" novalidate style="width: 100%; position: absolute; display: flex; justify-content: center; align-items: center; flex-direction: column; padding-right: 16px;">

        <div class="mb-3">
        <label for="username" class="form-label" style="color: rgb(250, 244, 244);">Email</label>
        <input
          placeholder="Enter your email"
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        />
      </div>

        <div class="mb-3">
        <label for="password" class="form-label" style="color: rgb(250, 244, 244);">Password</label>
        <input
          placeholder="**********"
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        />
      </div>

      <div style="text-align: center;">
      <button class="btn mt-3" style="width: 100%; color: white; background-color: #ff3a3adb; border: none;">Sign in</button>
      </div>
    </form>
  </div>
</div>

